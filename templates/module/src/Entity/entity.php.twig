{% extends "base/class.php.twig" %}

{% block file_path %}
\Drupal\{{ machine_name }}\Entity\{{ entity_class }}.
{% endblock %}

{% block namespace_class %}
namespace Drupal\{{ machine_name }}\Entity;
{% endblock %}

{% block use_class %}
use Drupal\Core\Config\Entity\ConfigEntityBase;
use Drupal\{{ machine_name }}\{{ entity_class }}Interface;
use Drupal\Core\Config\Entity\Attribute\ConfigEntityType;
use Drupal\Core\StringTranslation\TranslatableMarkup;
{% endblock %}

{% block class_declaration %}
#[ConfigEntityType(
  id: "{{ entity_name }}",
  label: new TranslatableMarkup("{{ label }}"),
  handlers: [
    "list_builder" => "Drupal\\{{ machine_name }}\\{{ entity_class }}ListBuilder",
    "form" => [
      "add" => "Drupal\\{{ machine_name }}\\Form\\{{ entity_class }}Form",
      "edit" => "Drupal\\{{ machine_name }}\\Form\\{{ entity_class }}Form",
      "delete" => "Drupal\\{{ machine_name }}\\Form\\{{ entity_class }}DeleteForm",
    ],
  ],
  config_prefix: "{{ entity_name }}",
  admin_permission: "administer site configuration",
  entity_keys: [
    "id" => "id",
    "label" => "label",
    "uuid" => "uuid",
  ],
  links: [
    "canonical" => "/admin/structure/{{ entity_name }}/{{ '{'~entity_name~'}' }}",
    "edit-form" => "/admin/structure/{{ entity_name }}/{{ '{'~entity_name~'}' }}/edit",
    "delete-form" => "/admin/structure/{{ entity_name }}/{{ '{'~entity_name~'}' }}/delete",
    "collection" => "/admin/structure/visibility_group",
  ]
)]
class {{ entity_class }} extends ConfigEntityBase implements {{ entity_class }}Interface {% endblock %}
{% block class_methods %}
  /**
   * The {{ label }} ID.
   *
   * @var string
   */
  protected $id;

  /**
   * The {{ label }} label.
   *
   * @var string
   */
  protected $label;
{% endblock %}
